# PostgreSQL 14+ connection string. Use a managed database URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signaldesk
# Remote databases use certificate-verified TLS by default; localhost does not.
# Set true/false only to explicitly override that behavior for your provider.
DATABASE_SSL=
# Per-process connection cap; keep this low enough for serverless scale-out.
DATABASE_POOL_MAX=10

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Public origin, without a trailing slash. Configure the deployed app origin in production.
BETTER_AUTH_URL=http://localhost:3000

# SMTP is required in production because email verification and password reset are enabled.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SignalDesk <no-reply@example.com>
